/.php-cs-fixer.cache
/tests/.phpunit.cache
/.phpunit.cache/
.phpunit.cache/
.phpunit.result.cache
/coverage/
/coverage-frontend/
/phpmetrics/
/quality-reports/
/phpqa/
phpcs-output.json

