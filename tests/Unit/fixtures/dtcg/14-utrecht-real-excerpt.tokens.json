{
  "utrecht": {
    "color": {
      "$type": "color",
      "red": {
        "40": { "$value": "hsl(0 100% 40%)", "$description": "basis rood #cc0000" }
      },
      "blue": {
        "35": { "$value": "hsl(211 60% 35%)", "$description": "basis link en knoppen CTA donkerblauw" },
        "40": { "$value": "hsl(211 60% 40%)", "$description": "blauw variant bij hover/focus #3669a5" }
      },
      "grey": {
        "30": { "$value": "hsl(0 0% 30%)", "$description": "border grijs #888" }
      },
      "white": { "$value": "hsl(0 0% 100%)" },
      "black": { "$value": "hsl(0 0% 0%)" }
    },
    "typography": {
      "$type": "fontFamily",
      "sans-serif": { "$value": ["Fira Sans", "sans-serif"] }
    }
  },
  "nl": {
    "heading": {
      "level-1": {
        "font-family": { "$value": "{utrecht.typography.sans-serif}" }
      }
    }
  },
  "color": {
    "primary": { "$value": "{utrecht.color.blue.35}" }
  }
}
