{
  "ams": {
    "color": {
      "$type": "color",
      "background": {
        "body": { "$value": "#ffffff" },
        "default": { "$value": "#ffffff", "$description": "The default background colour for form controls and smaller surfaces." }
      },
      "feedback": {
        "error": { "$value": "#ec0000" },
        "info": { "$value": "#009de6" }
      },
      "interactive": {
        "default": { "$value": "#004699" },
        "hover": { "$value": "#003677" }
      },
      "text": {
        "default": { "$value": "#202020" }
      }
    },
    "typography": {
      "font-family": {
        "$value": ["Amsterdam Sans", "Arial", "sans-serif"],
        "$type": "fontFamily",
        "$description": "The corporate typeface with system fallbacks."
      },
      "hyphenate-limit-chars": {
        "$value": "auto",
        "$description": "Lets the browser decide the minimum character count for hyphenation.",
        "$extensions": { "nl.amsterdam.type": "hyphenateLimitChars" }
      },
      "italic": {
        "font-style": {
          "$value": "italic",
          "$extensions": { "nl.amsterdam.type": "fontStyle" }
        }
      },
      "body-text": {
        "font-weight": { "$value": "400", "$type": "fontWeight" },
        "line-height": {
          "$value": 1.6,
          "$extensions": { "nl.amsterdam.subtype": "lineHeight" },
          "$type": "number"
        },
        "small": {
          "font-size": {
            "$value": { "value": 1, "unit": "rem" },
            "$type": "dimension",
            "$description": "Fixed at 16px; does not scale."
          }
        }
      }
    }
  }
}
