<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>nldesign</id>
	<name>NL Design System Theme</name>
	<summary>Apply Dutch government design tokens (NL Design System) to Nextcloud</summary>
	<description><![CDATA[
This app allows you to apply NL Design System design tokens to your Nextcloud instance.

Supported design token sets:
- Rijkshuisstijl (Dutch national government)
- Gemeente Utrecht
- Gemeente Amsterdam
- Gemeente Den Haag
- Gemeente Rotterdam

Configure which token set to use in the admin settings.
	]]></description>
	<version>0.1.2</version>
	<licence>agpl</licence>
	<author mail="info@conduction.nl" homepage="https://www.conduction.nl/">Conduction</author>
	<namespace>NLDesign</namespace>
	<category>customization</category>
	<website>https://github.com/ConductionNL/nldesign</website>
	<bugs>https://github.com/ConductionNL/nldesign/issues</bugs>
	<repository type="git">https://github.com/ConductionNL/nldesign.git</repository>

	<screenshot>https://raw.githubusercontent.com/ConductionNL/nldesign/main/img/screenshot.png</screenshot>

	<dependencies>
		<!--
			Nextcloud floor raised from 28 to 32 so the app may require PHP 8.3.
			Fleet wide product directive: standardise on Nextcloud 32.
			Rationale (openconnector issue 1172): an app must never advertise a
			Nextcloud floor lower than the highest floor of any app it depends on,
			or the App Store offers the app on releases where the dependency
			refuses to install. openregister on development declares a Nextcloud
			floor of 32. The max-version below is unchanged by this commit.
		-->
		<php min-version="8.3"/>
		<nextcloud min-version="32" max-version="33"/>
	</dependencies>
	<settings>
		<admin>OCA\NLDesign\Settings\Admin</admin>
		<admin-section>theming</admin-section>
	</settings>
</info>
